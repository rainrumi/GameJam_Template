<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MRubyCS.Serializer</id>
    <version>0.102.0</version>
    <authors>hadashiA</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/hadashiA/MRubyCS</projectUrl>
    <description>A plugin for MRubyCS that enables conversion between C# and mruby objects.</description>
    <repository type="git" url="https://github.com/hadashiA/MRubyCS" commit="25fa2226edd59ee503e291dc93e16c183c92d7ea" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="MRubyCS" version="0.102.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="MRubyCS" version="0.102.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="MRubyCS" version="0.102.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="MRubyCS" version="0.102.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>