{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.nuiindicator/style-profile.schema.json",
  "title": "NuiIndicator AI Coding Style Profile",
  "type": "object",
  "required": [
    "profileVersion",
    "project",
    "snapshot",
    "architecture",
    "dataDesign",
    "naming",
    "formatting",
    "comments",
    "testing"
  ],
  "properties": {
    "profileVersion": { "type": "integer", "minimum": 1 },
    "project": { "type": "string", "minLength": 1 },
    "language": { "type": "string" },
    "snapshot": { "type": "object" },
    "priority": { "type": "array", "items": { "type": "string" } },
    "architecture": { "type": "object" },
    "dataDesign": { "type": "object" },
    "async": { "type": "object" },
    "naming": { "type": "object" },
    "formatting": { "type": "object" },
    "comments": { "type": "object" },
    "testing": { "type": "object" },
    "doNotIntroduce": { "type": "array", "items": { "type": "string" } },
    "evidenceFiles": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
